#!name = 特来电 · 打卡领好礼
#!desc = 查询当前奖品与挑战进度；每日09:00仅无任务日打卡；有任务提醒。导入后打开活动页获取登录态。
#!author = Codex
#!homepage = https://github.com/amus1ng/loon-plugins
#!system = iOS,iPadOS
#!system_version = 15.0
#!date = 2026-10-15

[Script]
http-request ^https:\/\/c2\.teld\.(cn|cc)\/gencode\/tffH5\/SignHomepage(\?|$) script-path=https://raw.githubusercontent.com/amus1ng/loon-plugins/main/loon/telaidian.js?v=20261015-reward,tag=特来电获取登录态-活动页,requires-body=false,timeout=10,enable=true
http-request ^https:\/\/sgi\.teld\.cn\/api\/[Ii]nvoke\?(?=.*\bSID=(ProSrv-GetCheckIn(Status|Task)|UserAPI-WEBUI-SRefreshToken)(&|$)) script-path=https://raw.githubusercontent.com/amus1ng/loon-plugins/main/loon/telaidian.js?v=20261015-reward,tag=特来电获取登录态-接口,requires-body=true,timeout=10,enable=true
cron "0 9 * * *" script-path=https://raw.githubusercontent.com/amus1ng/loon-plugins/main/loon/telaidian.js?v=20261015-reward,tag=特来电每日打卡,argument="mode=run",timeout=120,enable=true
generic script-path=https://raw.githubusercontent.com/amus1ng/loon-plugins/main/loon/telaidian.js?v=20261015-reward,tag=特来电查看奖品,argument="mode=reward",timeout=120
generic script-path=https://raw.githubusercontent.com/amus1ng/loon-plugins/main/loon/telaidian.js?v=20261015-reward,tag=特来电状态检查,argument="mode=status",timeout=120
generic script-path=https://raw.githubusercontent.com/amus1ng/loon-plugins/main/loon/telaidian.js?v=20261015-reward,tag=特来电立即打卡,argument="mode=run",timeout=120
generic script-path=https://raw.githubusercontent.com/amus1ng/loon-plugins/main/loon/telaidian.js?v=20261015-reward,tag=特来电清除登录态,argument="mode=clear",timeout=10

[Mitm]
hostname = c2.teld.cn,c2.teld.cc,sgi.teld.cn
